<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <UserSecretsId>23a5f66d-ed0f-4a4f-b84c-3f35284b6c04</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Tools" Version="2.76.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FastEndpoints" Version="8.0.1" />
    <PackageReference Include="FastEndpoints.Swagger" Version="8.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <ProjectReference Include="..\commons\commons.csproj" />
    <ProjectReference Include="..\security\security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\users\Protos\usersService.proto" AdditionalImportDirs="../commons" GrpcServices="Client" Link="Protos\usersService.proto" />
    <Protobuf Include="..\forum\Protos\forumService.proto" AdditionalImportDirs="../commons" GrpcServices="Client" Link="Protos\forumService.proto" />
	<Protobuf Include="..\forum\Protos\votesService.proto" AdditionalImportDirs="../commons" GrpcServices="Client" Link="Protos\votesService.proto" />
    <Protobuf Include="..\images\Protos\imagesService.proto" AdditionalImportDirs="../commons" GrpcServices="Client" Link="Protos\imagesService.proto" />
  </ItemGroup>

</Project>
