# Template for .env - copy this file to .env (same folder) and fill in the values.
# docker compose reads .env automatically. .env is git-ignored; only this template is committed.

# JWT signing key - users service issues tokens, http gateway validates them.
# Required: a random string of at least 32 characters.
JWT_SECRET_KEY=

# Brevo - ban notification emails (users service)
BREVO_API_KEY=
# Must be a verified sender in your Brevo account
BREVO_EMAIL_FROM=

# Vonage - ban notification SMS (users service). Leave empty to skip sending SMS.
VONAGE_API_KEY=
VONAGE_API_SECRET=
# International format without +, e.g. 40712345678
VONAGE_TARGET_PHONE_NUMBER=
