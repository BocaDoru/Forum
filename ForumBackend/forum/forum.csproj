<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <UserSecretsId>7a317891-8b0d-490f-9401-6dbb3deefcce</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Tools" Version="2.76.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <ProjectReference Include="..\commons\commons.csproj" />
    <ProjectReference Include="..\database\database.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\questionsService.proto" AdditionalImportDirs="../commons" GrpcServices="Server" />
    <Protobuf Include="Protos\commentsService.proto" AdditionalImportDirs="../commons" GrpcServices="Server" />
    <Protobuf Include="..\users\Protos\usersService.proto" AdditionalImportDirs="../commons" GrpcServices="Client" Link="Protos\usersService.proto" />
	<Protobuf Include="Protos\votesService.proto" AdditionalImportDirs="../commons" GrpcServices="Server" />
  </ItemGroup>

</Project>
